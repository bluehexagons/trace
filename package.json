{
  "name": "trace",
  "version": "0.1.1",
  "description": "Trace - An esoteric, specialized, functional programming language",
  "keywords": [
    "esoteric",
    "functional",
    "language",
    "programming"
  ],
  "homepage": "https://github.com/bluehexagons/trace#readme",
  "bugs": {
    "url": "https://github.com/bluehexagons/trace/issues"
  },
  "license": "MIT",
  "author": "bluehexagons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluehexagons/trace.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "browser": "./dist/trace.js",
      "import": "./dist/trace.js",
      "default": "./dist/trace.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "prepare": "npm run build",
    "start": "npm run build && node dist/cli.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^20.19.0 || >=22.12.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
